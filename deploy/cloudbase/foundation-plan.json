{
  "schema_version": 1,
  "purpose": "audited CloudBase Run foundation plan; not an importable Tencent Cloud API payload",
  "environment_id_committed": false,
  "region": "ap-shanghai",
  "service_name": "trainpal-demo",
  "container": {
    "port": 8000,
    "command_contract": "one-uvicorn-worker",
    "serves_web_and_api_same_origin": true,
    "logs": [
      "stdout"
    ]
  },
  "capacity": {
    "cpu_cores": 2,
    "memory_gib": 4,
    "minimum_instances_idle": 0,
    "minimum_instances_judging": 1,
    "maximum_instances": 1,
    "request_timeout_seconds": 240
  },
  "network": {
    "public_https": true,
    "public_https_enabled_only_after_private_gates": true,
    "public_canary_required_before_link_announcement": true,
    "public_https_disabled_after_confirmed_demo_end": true,
    "default_domain_classification": "development-demo-only",
    "custom_domain_required": false
  },
  "runtime": {
    "app_env": "production",
    "analysis_provider": "cloud",
    "judge_analysis_concurrency": 0,
    "public_analysis_concurrency": 1,
    "public_attempt_limit": 1,
    "public_attempt_window_seconds": 600,
    "run_timeout_seconds": 180,
    "local_upload_enabled": true,
    "local_analysis_max_seconds": 300,
    "local_upload_max_bytes": 268435456,
    "analysis_evidence_timeout_seconds": 170,
    "analysis_chunk_timeout_seconds": 20,
    "analysis_visual_chunk_seconds": 60,
    "analysis_visual_overlap_seconds": 10,
    "unauthenticated_page_browse": true,
    "judge_code_required_for_paid_analysis": false,
    "anonymous_paid_analysis": true,
    "gymti_llm_enabled": true,
    "gymti_llm_provider": "ark-doubao",
    "gymti_llm_concurrency": 3,
    "gymti_llm_request_quota": null,
    "raw_media_persistence": "forbidden",
    "active_run_state": "single-process-memory"
  },
  "asset_contract": {
    "controlled_sources_required": true,
    "source_manifest_path": "/workspace/competition/media-manifest.json",
    "source_media_root": "/workspace/tmp/controlled-media",
    "controlled_source_count": 5,
    "public_media_base_url_required": true,
    "ffmpeg_path": "/opt/trainpal/ffmpeg/bin/ffmpeg",
    "ffmpeg_receipt_path": "/opt/trainpal/ffmpeg/receipt.json",
    "smoke_annotations_path": null,
    "must_verify_ffmpeg_receipt": true,
    "assets_deferred_until_content_approval": false
  },
  "release_gates": {
    "private": {
      "immutable_image_verified": true,
      "configuration_snapshot_recorded": true,
      "internal_health_ready": true,
      "rollback_target_retained": true
    },
    "public_canary": {
      "public_health_ready": true,
      "public_analysis_sse_result": true,
      "second_browser_entry": true,
      "concurrent_public_requests": 2,
      "accepted_public_requests": 1,
      "over_capacity_http_status": 429,
      "memory_pressure_observed": true,
      "rollback_smoke": true
    }
  },
  "rollback": {
    "minimum_previous_versions_retained": 1,
    "configuration_snapshot_required": true,
    "switch_target": "previous-immutable-commit-version",
    "post_switch_ready_probe_required": true
  },
  "required_secret_environment_keys": [
    "ACCESS_COOKIE_SECRET",
    "ARK_API_KEY",
    "JUDGE_ACCESS_CODE",
    "VOLC_ASR_API_KEY"
  ],
  "required_nonsecret_environment_keys": [
    "ANALYSIS_CHUNK_TIMEOUT_SECONDS",
    "ANALYSIS_EVIDENCE_TIMEOUT_SECONDS",
    "ANALYSIS_PROVIDER",
    "ANALYSIS_VISUAL_CHUNK_SECONDS",
    "ANALYSIS_VISUAL_OVERLAP_SECONDS",
    "APP_ENV",
    "ARK_BASE_URL",
    "ARK_MODEL_ID",
    "ARK_VISUAL_MODEL_ID",
    "CORS_ORIGINS",
    "FFMPEG_BUILD_RECEIPT_PATH",
    "IMAGEIO_FFMPEG_EXE",
    "JUDGE_ANALYSIS_CONCURRENCY",
    "LOCAL_ANALYSIS_MAX_SECONDS",
    "LOCAL_UPLOAD_ENABLED",
    "LOCAL_UPLOAD_MAX_BYTES",
    "PUBLIC_ANALYSIS_CONCURRENCY",
    "RUN_TIMEOUT_SECONDS",
    "RUN_TTL_SECONDS",
    "TRUSTED_PROXY_CIDRS",
    "VOLC_ASR_RESOURCE_ID",
    "VOLC_ASR_URL",
    "WEB_STATIC_ROOT"
  ],
  "release_managed_secret_alias_environment_keys": [
    "GYMTI_LLM_API_KEY"
  ],
  "release_managed_nonsecret_environment_keys": [
    "APP_RELEASE_SHA",
    "GYMTI_LLM_BASE_URL",
    "GYMTI_LLM_CONCURRENCY",
    "GYMTI_LLM_ENABLED",
    "GYMTI_LLM_MODEL",
    "GYMTI_LLM_RETENTION_CONFIRMED",
    "PUBLIC_MEDIA_BASE_URL",
    "SOURCE_MANIFEST_PATH",
    "SOURCE_MEDIA_ROOT"
  ],
  "budget": {
    "currency": "CNY",
    "hard_ceiling": 300,
    "pricing_source": "https://cloud.tencent.com/document/product/1243/90265",
    "assumed_ccu_price_cny_per_hour": 0.22,
    "ccu_per_warm_instance": 2,
    "maximum_public_window_hours": 52,
    "maximum_warm_hours": 18,
    "estimated_compute_ceiling_cny": 7.92,
    "estimated_continuous_compute_ceiling_cny": 22.88,
    "confirmed_demo_end": "2026-07-25T00:00:00+08:00",
    "unpriced_resources_require_console_confirmation": true,
    "purchase_requires_fresh_confirmation": true
  },
  "submission_deadline": "2026-07-23T11:00:00+08:00"
}
