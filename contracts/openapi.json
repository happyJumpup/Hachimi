{
  "components": {
    "schemas": {
      "ActionMode": {
        "enum": [
          "reps",
          "duration"
        ],
        "title": "ActionMode",
        "type": "string"
      },
      "AnalysisCandidate": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceSpan"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "needs_confirmation": {
            "title": "Needs Confirmation",
            "type": "boolean"
          },
          "parameters": {
            "$ref": "#/components/schemas/CandidateParameters"
          },
          "segment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Segment"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source_id",
          "segment",
          "parameters",
          "evidence",
          "needs_confirmation"
        ],
        "title": "AnalysisCandidate",
        "type": "object"
      },
      "AnalysisError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "AnalysisError",
        "type": "object"
      },
      "AnalysisRunView": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/AnalysisCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "empty_reason": {
            "anyOf": [
              {
                "const": "no_evidence",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Empty Reason"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/RunStage"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "trigger_seconds": {
            "title": "Trigger Seconds",
            "type": "number"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/AnalysisWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "source_id",
          "trigger_seconds",
          "status",
          "stage"
        ],
        "title": "AnalysisRunView",
        "type": "object"
      },
      "AnalysisWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "speech_unavailable",
              "visual_unavailable"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "AnalysisWarning",
        "type": "object"
      },
      "CandidateParameters": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "reps": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reps"
          },
          "rest_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rest Seconds"
          },
          "sets": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sets"
          }
        },
        "title": "CandidateParameters",
        "type": "object"
      },
      "CreateAnalysisRunRequest": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "trigger_seconds": {
            "minimum": 0.0,
            "title": "Trigger Seconds",
            "type": "number"
          }
        },
        "required": [
          "source_id",
          "trigger_seconds"
        ],
        "title": "CreateAnalysisRunRequest",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "configuration_error",
          "provider_error",
          "schema_error",
          "media_error",
          "timeout",
          "cancelled"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "EvidenceSpan": {
        "additionalProperties": false,
        "properties": {
          "end_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "End Seconds",
            "type": "number"
          },
          "start_seconds": {
            "minimum": 0.0,
            "title": "Start Seconds",
            "type": "number"
          },
          "type": {
            "$ref": "#/components/schemas/EvidenceType"
          }
        },
        "required": [
          "start_seconds",
          "end_seconds",
          "type"
        ],
        "title": "EvidenceSpan",
        "type": "object"
      },
      "EvidenceType": {
        "enum": [
          "speech",
          "visual"
        ],
        "title": "EvidenceType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunStage": {
        "enum": [
          "queued",
          "preparing_media",
          "analyzing_evidence",
          "expanding_window",
          "fusing_candidates",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "RunStage",
        "type": "string"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "Segment": {
        "additionalProperties": false,
        "properties": {
          "end_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "End Seconds",
            "type": "number"
          },
          "start_seconds": {
            "minimum": 0.0,
            "title": "Start Seconds",
            "type": "number"
          }
        },
        "required": [
          "start_seconds",
          "end_seconds"
        ],
        "title": "Segment",
        "type": "object"
      },
      "SourceSummary": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "media_url": {
            "title": "Media Url",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "media_url",
          "duration_seconds"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Hachimi Action Analysis API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analysis-runs": {
      "post": {
        "operationId": "create_run_api_v1_analysis_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAnalysisRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run"
      }
    },
    "/api/v1/analysis-runs/{run_id}": {
      "delete": {
        "operationId": "cancel_run_api_v1_analysis_runs__run_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Run"
      },
      "get": {
        "operationId": "get_run_api_v1_analysis_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    },
    "/api/v1/analysis-runs/{run_id}/events": {
      "get": {
        "operationId": "run_events_api_v1_analysis_runs__run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Events"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "list_sources_api_v1_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceSummary"
                  },
                  "title": "Response List Sources Api V1 Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sources"
      }
    },
    "/api/v1/sources/{source_id}/media": {
      "get": {
        "operationId": "source_media_api_v1_sources__source_id__media_get",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Source Media"
      }
    }
  }
}
