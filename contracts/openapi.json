        "type": "string"
      },
      "CreateAnalysisRunRequest": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "trigger_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated compatibility metadata; full-source analysis ignores it.",
            "title": "Trigger Seconds"
          }
        },
        "required": [
          "source_id"
        ],
        "title": "CreateAnalysisRunRequest",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "configuration_error",
          "provider_error",
