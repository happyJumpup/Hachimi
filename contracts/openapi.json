        "type": "object"
      },
      "EvidenceType": {
        "enum": [
          "speech",
          "visual"
        ],
        "title": "EvidenceType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NotReadyResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
